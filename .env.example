# ==============================================================================
# JAGA-KODE Environment Variables Template (.env.example)
# ==============================================================================

# Google Gemini API Key for Clinical Copilot (XAI & Dispute Confirmation Draft)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# JAGA-KODE API Configuration
JAGA_KODE_TRUST_PROXY_HEADERS=0
JAGA_KODE_RATE_LIMIT_PER_MIN=300
JAGA_KODE_MAX_BODY_BYTES=5242880
