# ==============================================================================
# .gitignore - JAGA-KODE AI Engineering & Data Science Project
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.dll
*.dylib

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Environment & Secrets Protection (UU PDP & API Key Security)
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# Virtual Environments
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints & autosaves
.ipynb_checkpoints
*/.ipynb_checkpoints/*
*.sublime-project
*.sublime-workspace

# IDE & Editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Data protection (UU PDP No. 27/2022 Compliance)
# Abaikan seluruh data riil, dump database, dan file mentah besar
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/references/*
!data/references/.gitkeep
data/synthetic/*
!data/synthetic/.gitkeep
*.csv
*.tsv
*.xlsx
*.parquet
*.feather
*.h5
*.sql
*.dump
*.dta
*.zip
*.tar.gz
*.7z

# Model weights, serialized pipelines, & large checkpoints
models/core/*
!models/core/.gitkeep
!models/core/README.md
models/baselines/*
!models/baselines/.gitkeep
*.pkl
*.pickle
*.joblib
*.bin
*.pt
*.pth
*.onnx

# Log files & runtime dumps
logs/audit/*
!logs/audit/.gitkeep
logs/system/*
!logs/system/.gitkeep
*.log

# Test & coverage outputs
.coverage
htmlcov/
.pytest_cache/

# Frontend Web (Node / Vite)
node_modules/
.vite/
*.tsbuildinfo

# ==============================================================================
# Dokumen Panduan & Materi Internal Panitia BPJS (Disembunyikan dari Repo Publik)
# ==============================================================================
images/export/*
!images/export/.gitkeep

docs/BPJS Healthkaton 2026 - Basic.pdf
docs/Healthkathon 2026 - Alur Kegiatan Healthkathon.pdf
docs/Materi HealthKathon 2026.pdf
docs/Materi_Data_Sample_BPJS_Kesehatan_Healthkaton2026.pdf
docs/Template Project Final Healthkathon 2026.pdf
docs/Building_Practical_Al_Inference_Pipeline_From_Data_to_API_Said_Achmad.pdf
docs/*.docx
docs/DOKUMENTASI_PRESENTASI_FINAL_HEALTHKATHON_2026.md

# ==============================================================================
# Internal Presentation Scripts, HTML Deck & Report Generator
# ==============================================================================
reports/presentasi/
scripts/generate_final_report_html.py
reports/figures/preview_cover_updated.png
images/output/app_screenshot_*.png

